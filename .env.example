# Slack notification webhook URL
# See: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# LINE Messaging API token（将来の通知先拡張用）
LINE_CHANNEL_ACCESS_TOKEN=your-line-token

# API data source
# Default: https://raw.githubusercontent.com/kwaka1208/jma-api/main/api/latest.json
API_URL=https://raw.githubusercontent.com/kwaka1208/jma-api/main/api/latest.json

# Test mode: set to 'true' to preview notifications without sending
SLACK_NOTIFY_TEST=false
