# 本番環境用設定（Secret Manager推奨）
# .env.production にコピーして設定してください（コミット不可）

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
NODE_ENV=production

# User Agent
USER_AGENT=jma-alert-bot/1.0 (+https://example.com/contact)

# GitHub API
PUSH_TO_GITHUB=true
GITHUB_OWNER=your-github-username
GITHUB_REPO=jma-alert-api

# GitHub Token（Secret Manager から取得されるため、ここでは不要）
# GITHUB_TOKEN=（Secret Manager から自動取得）

# フィード設定
TITLE_ALLOW=気象警報・注意報,土砂災害,危険警報,特別警報,気象防災速報,震源・震度に関する情報,津波,噴火
TARGET_AREAS=

# Cloud Scheduler
# 毎分実行: */1 * * * *
# タイムゾーン: Asia/Tokyo
